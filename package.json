{
  "name": "ceylon-1802",
  "version": "0.1.0",
  "description": "Browser-based, mobile-first, all-text MMORPG set in 1802 Ceylon",
  "private": true,
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json && cp -r client/public/* dist/client/",
    "build": "npm run build:server && npm run build:client",
    "seed": "node dist/server/seed.js",
    "start": "node dist/server/index.js",
    "dev": "tsx watch server/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
